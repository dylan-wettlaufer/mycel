{
  "name": "mycel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @mycel/server dev",
    "dev:web": "pnpm --filter @mycel/web dev",
    "start": "node packages/cli/dist/bin.js",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm run build && pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
