{
  "version": 1,
  "source": "agent",
  "parts": [
    {
      "id": "launcher",
      "name": "Dashboard launcher",
      "purpose": "Finds and opens the local dashboard.",
      "kind": "cli",
      "paths": ["packages/cli/**"]
    },
    {
      "id": "api",
      "name": "Local dashboard API",
      "purpose": "Serves graph data and live updates.",
      "kind": "service",
      "paths": ["packages/server/**"]
    },
    {
      "id": "parser",
      "name": "TypeScript source analysis",
      "purpose": "Extracts TypeScript symbols and links.",
      "kind": "library",
      "paths": ["packages/parser/**"]
    },
    {
      "id": "indexer",
      "name": "Repository indexing",
      "purpose": "Keeps the repository index current.",
      "kind": "library",
      "paths": ["packages/core/**"],
      "subcomponents": [
        {
          "id": "index-updates",
          "name": "Index updates",
          "purpose": "Runs full and incremental indexing and commits graph revisions.",
          "paths": [
            "packages/core/src/indexer.ts",
            "packages/core/src/live-index.ts",
            "packages/core/src/history.ts"
          ]
        },
        {
          "id": "file-watching",
          "name": "File watching",
          "purpose": "Detects source changes and queues them for indexing.",
          "paths": [
            "packages/core/src/watcher.ts",
            "packages/core/src/changes.ts"
          ]
        },
        {
          "id": "source-capture",
          "name": "Source capture",
          "purpose": "Discovers and reads source files in the repository.",
          "paths": [
            "packages/core/src/discovery.ts",
            "packages/core/src/files.ts",
            "packages/core/src/settings.ts"
          ]
        },
        {
          "id": "dependency-resolution",
          "name": "Graph building and resolution",
          "purpose": "Resolves code relationships and builds the structural and semantic graphs.",
          "paths": [
            "packages/core/src/module-resolution.ts",
            "packages/core/src/resolver.ts",
            "packages/core/src/graph.ts"
          ]
        }
      ]
    },
    {
      "id": "storage",
      "name": "Graph and revision storage",
      "purpose": "Stores graphs and revisions in SQLite.",
      "kind": "data",
      "paths": ["packages/db/**"]
    },
    {
      "id": "contracts",
      "name": "Shared graph contracts",
      "purpose": "Defines shared graph and API types.",
      "kind": "library",
      "paths": ["packages/shared/**"]
    },
    {
      "id": "workspace",
      "name": "Code exploration workspace",
      "purpose": "Explores code and recent changes.",
      "kind": "app",
      "paths": ["apps/web/**"]
    },
    {
      "id": "architecture",
      "name": "Architecture mapping",
      "purpose": "Maps parts and their dependencies.",
      "kind": "library",
      "paths": [
        "packages/core/src/architecture*.ts",
        "apps/web/src/features/architecture/**"
      ]
    },
    {
      "id": "behaviour",
      "name": "Feature and behaviour tracing",
      "purpose": "Traces how application features work.",
      "kind": "library",
      "paths": [
        "packages/core/src/semantic/**",
        "packages/core/src/behaviour/**",
        "apps/web/src/features/semantic/**"
      ]
    }
  ]
}
