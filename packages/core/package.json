{
  "name": "@mycel/core",
  "version": "0.0.0",
  "private": true,
  "description": "Indexing, watching, and change coordination.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @mycel/core... build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mycel/parser": "workspace:*",
    "@mycel/db": "workspace:*",
    "@mycel/shared": "workspace:*",
    "ignore": "7.0.14",
    "picomatch": "4.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "4.0.3"
  }
}
