{
  "name": "@mycel/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line entry point and application lifecycle.",
  "type": "module",
  "bin": {
    "mycel": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin.js",
    "test": "pnpm --filter @mycel/web build && pnpm --filter @mycel/cli... build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mycel/core": "workspace:*",
    "@mycel/server": "workspace:*",
    "@mycel/shared": "workspace:*",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@mycel/db": "workspace:*",
    "@types/node": "^22.20.5"
  }
}
