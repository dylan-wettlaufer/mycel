{
  "name": "@mycel/server",
  "version": "0.0.0",
  "private": true,
  "description": "Local HTTP API, events, and static asset serving.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "test": "pnpm --filter @mycel/server... build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mycel/core": "workspace:*",
    "@mycel/shared": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
